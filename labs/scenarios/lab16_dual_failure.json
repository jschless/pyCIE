{
  "name": "dual_failure_reconvergence",
  "lab_id": "lab16",
  "topology": {
    "nodes": ["pe1", "pe2", "p1", "p2", "ce1", "ce2"],
    "links": [
      ["pe1:eth0", "p1:eth0"],
      ["pe1:eth1", "p2:eth0"],
      ["pe2:eth0", "p1:eth1"],
      ["pe2:eth1", "p2:eth1"],
      ["ce1:eth0", "pe1:eth2"],
      ["ce2:eth0", "pe2:eth2"]
    ]
  },
  "actions": [
    {
      "at_ms": 1000,
      "action": "fail_link",
      "params": {"a": "pe1:eth0", "b": "p1:eth0"}
    },
    {
      "at_ms": 1100,
      "action": "route_set_absent",
      "params": {"selector": "node=pe1,prefix=10.200.2.0/24,vrf=CUST_A"}
    },
    {
      "at_ms": 1300,
      "action": "fail_bgp_peer",
      "params": {"node": "pe1", "peer": "pe2"}
    },
    {
      "at_ms": 2650,
      "action": "route_set_present",
      "params": {"selector": "node=pe1,prefix=10.200.2.0/24,vrf=CUST_A"}
    },
    {
      "at_ms": 2700,
      "action": "mark_converged",
      "params": {}
    }
  ],
  "expectations": [
    {
      "kind": "route_present",
      "selector": "node=pe1,prefix=10.200.2.0/24,vrf=CUST_A",
      "expected": true
    },
    {
      "kind": "convergence_ms_lte",
      "selector": "fabric",
      "expected": 2000
    }
  ],
  "metadata": {
    "initial_routes": {
      "node=pe1,prefix=10.200.2.0/24,vrf=CUST_A": true
    }
  }
}
